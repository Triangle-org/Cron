{
  "name": "triangle/cron",
  "description": "Cron scheduler integration for Triangle Engine 9 and Localzet Server 7.",
  "type": "library",
  "keywords": [
    "localzet",
    "Triangle",
    "Cron",
    "scheduler",
    "server"
  ],
  "license": "AGPL-3.0-or-later",
  "authors": [
    {
      "role": "Developer",
      "name": "Ivan Zorin",
      "email": "creator@localzet.com",
      "homepage": "https://github.com/localzet"
    }
  ],
  "support": {
    "email": "support@localzet.com",
    "source": "https://github.com/Triangle-org/Cron"
  },
  "autoload": {
    "psr-4": {
      "Triangle\\": "",
      "Triangle\\Cron\\": "src"
    }
  },
  "require": {
    "php": "^8.1",
    "triangle/engine": "^9.0",
    "localzet/cron": "^2.0"
  },
  "scripts": {
    "lint": "find . -path './vendor' -prune -o -path './.git' -prune -o -name '*.php' -type f -print0 | xargs -0 -n1 php -l",
    "test": "php tests/compatibility.php",
    "check": [
      "@lint",
      "@test"
    ]
  },
  "suggest": {
  },
  "config": {
    "platform": {
      "php": "8.1.0"
    }
  }
}
